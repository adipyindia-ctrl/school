# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/school_erp

# ─── Security ────────────────────────────────────────────────
SECRET_KEY=changeme-use-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── App ─────────────────────────────────────────────────────
APP_NAME=SchoolERP
APP_ENV=development
APP_VERSION=1.0.0

# ─── First Super Admin (created on first run) ────────────────
SUPER_ADMIN_EMAIL=admin@schoolerp.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# ─── File Storage ────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Domain ───────────────────────────────────────────────────────────────────
# The base domain used for subdomain routing (e.g. yourdomain.com)
# School subdomains will be: {slug}.yourdomain.com
BASE_DOMAIN=yourdomain.com
